<UserControl x:Class="RazerChromaWLEDConnect.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="860">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,36" MaxWidth="1180">

            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Output" Style="{StaticResource TxtCaption}" />
                        <TextBlock Text="{Binding Performance.OutputFpsText}" Style="{StaticResource TxtFigure}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Performance.LoadText}" Style="{StaticResource TxtCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Razer frames" Style="{StaticResource TxtCaption}" />
                        <TextBlock Text="{Binding Performance.ChromaFpsText}" Style="{StaticResource TxtFigure}" Margin="0,4,0,0" />
                        <TextBlock Text="received per second" Style="{StaticResource TxtCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="UDP packets" Style="{StaticResource TxtCaption}" />
                        <TextBlock Text="{Binding Performance.PacketsText}" Style="{StaticResource TxtFigure}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Performance.BandwidthText}" Style="{StaticResource TxtCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Send latency" Style="{StaticResource TxtCaption}" />
                        <TextBlock Text="{Binding Performance.LatencyText}" Style="{StaticResource TxtFigure}" Margin="0,4,0,0" />
                        <TextBlock Text="per frame, all packets" Style="{StaticResource TxtCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Frame budget" Style="{StaticResource TxtH2}" />
                        <TextBlock Style="{StaticResource TxtBody}" Margin="0,4,0,0">
                            <Run Text="Target" />
                            <Run Text="{Binding Performance.TargetFps, Mode=OneWay}" />
                            <Run Text="frames per second. Skipped frames happen when Razer produces frames faster than the render thread sends them." />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="{Binding Performance.SkippedText}" Style="{StaticResource TxtFigure}" HorizontalAlignment="Right" />
                        <TextBlock Text="skipped frames" Style="{StaticResource TxtCaption}" HorizontalAlignment="Right" />
                        <Button Content="Reset counters" Style="{StaticResource BtnGhost}" Margin="0,8,0,0"
                                Command="{Binding Options.ResetStatisticsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Devices" Style="{StaticResource TxtH2}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource TxtCaption}" />
                        <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource TxtCaption}" />
                        <TextBlock Grid.Column="2" Text="Packets" Style="{StaticResource TxtCaption}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Latency" Style="{StaticResource TxtCaption}" TextAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DeviceList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Fill="{Binding StatusKey, Converter={StaticResource StatusToBrush}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource TxtCaption}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PacketsSent}" Style="{StaticResource TxtMono}"
                                               TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding LatencyMicroseconds}" Style="{StaticResource TxtMono}"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
