<UserControl x:Class="RazerChromaWLEDConnect.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:RazerChromaWLEDConnect.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="860">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,36" MaxWidth="1180">

            <!-- ================= status figures ================= -->
            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Status" Style="{StaticResource TxtCaption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Fill="{Binding ChromaStatusKey, Converter={StaticResource StatusToBrush}}" />
                            <TextBlock Text="{Binding StatusHeadline}" FontSize="16.5" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusHint}" Style="{StaticResource TxtCaption}"
                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Channels" Style="{StaticResource TxtCaption}" />
                        <TextBlock Text="{Binding ChannelCount}" Style="{StaticResource TxtFigure}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ChannelSummary}" Style="{StaticResource TxtCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Devices" Style="{StaticResource TxtCaption}" />
                        <TextBlock Text="{Binding ConnectedCount}" Style="{StaticResource TxtFigure}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource TxtCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Output" Style="{StaticResource TxtCaption}" />
                        <TextBlock Text="{Binding Performance.OutputFpsText}" Style="{StaticResource TxtFigure}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource TxtCaption}" Margin="0,2,0,0">
                            <Run Text="{Binding Performance.PacketsText, Mode=OneWay}" />
                            <Run Text=" packets per second" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ================= native razer input ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Razer live input" Style="{StaticResource TxtH2}" />
                            <TextBlock Text="The four colours Synapse actually broadcasts. Everything else is derived from these."
                                       Style="{StaticResource TxtCaption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Top">
                            <TextBlock Text="native" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                        </Border>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <Border Height="46" CornerRadius="8" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    Background="{Binding Anchor1Hex, Converter={StaticResource HexToBrush}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="C1" Style="{StaticResource TxtMono}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Anchor1Hex}" Style="{StaticResource TxtCaption}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <Border Height="46" CornerRadius="8" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    Background="{Binding Anchor2Hex, Converter={StaticResource HexToBrush}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="C2" Style="{StaticResource TxtMono}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Anchor2Hex}" Style="{StaticResource TxtCaption}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <Border Height="46" CornerRadius="8" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    Background="{Binding Anchor3Hex, Converter={StaticResource HexToBrush}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="C3" Style="{StaticResource TxtMono}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Anchor3Hex}" Style="{StaticResource TxtCaption}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <Border Height="46" CornerRadius="8" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    Background="{Binding Anchor4Hex, Converter={StaticResource HexToBrush}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="C4" Style="{StaticResource TxtMono}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Anchor4Hex}" Style="{StaticResource TxtCaption}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ================= channel palette ================= -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chroma palette" Style="{StaticResource TxtH2}" />
                            <TextBlock Text="C = a colour Razer sent. V = interpolated between two native anchors."
                                       Style="{StaticResource TxtCaption}" Margin="0,3,0,0" />
                        </StackPanel>

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Options.ChannelOptions}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ChannelCount"
                                                 Content="{Binding Label}" Margin="2,0"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding SelectCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <controls:PaletteStrip Margin="0,16,0,0" Height="58"
                                           Channels="{Binding Channels}"
                                           Revision="{Binding PaletteVersion}" />
                </StackPanel>
            </Border>


            <!-- ================= live output ================= -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Live output" Style="{StaticResource TxtH2}" />
                    <TextBlock Text="What each controller is receiving right now."
                               Style="{StaticResource TxtCaption}" Margin="0,3,0,0" />

                    <ItemsControl ItemsSource="{Binding DeviceList}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Fill="{Binding StatusKey, Converter={StaticResource StatusToBrush}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{StaticResource Sunken}"
                                            BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                            CornerRadius="5" Padding="2" Margin="0,0,10,0">
                                        <controls:LedStrip Device="{Binding}" Height="18" />
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding MappingSummary}"
                                               Style="{StaticResource TxtMono}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No controllers yet. Add one on the Devices page."
                               Style="{StaticResource TxtCaption}"
                               Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
