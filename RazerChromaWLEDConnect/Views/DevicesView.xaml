<UserControl x:Class="RazerChromaWLEDConnect.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="860">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,36" MaxWidth="1180">

            <!-- ================= toolbar ================= -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource TxtBody}" />
                    <TextBlock Style="{StaticResource TxtCaption}" Margin="0,3,0,0">
                        <Run Text="{Binding TotalLedCount, Mode=OneWay}" />
                        <Run Text=" LEDs driven in total" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Refresh" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding RefreshDevicesCommand}" />
                    <Button Content="Add WLED" Style="{StaticResource BtnPrimary}"
                            Command="{Binding AddDeviceCommand}" />
                </StackPanel>
            </Grid>

            <!-- ================= discovery ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Find controllers" Style="{StaticResource TxtH2}" />
                            <TextBlock Text="{Binding DiscoveryStatus}" Style="{StaticResource TxtCaption}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Search" Style="{StaticResource BtnGhost}" Margin="0,0,6,0"
                                    Command="{Binding StartDiscoveryCommand}"
                                    ToolTip="Ask the network for WLED controllers over mDNS." />
                            <Button Content="Stop" Style="{StaticResource BtnGhost}"
                                    Command="{Binding StopDiscoveryCommand}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Discovered}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                            <TextBlock Text="Answered on its JSON API. Not added yet."
                                                       Style="{StaticResource TxtCaption}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Add" Style="{StaticResource BtnPrimary}" Padding="12,4"
                                                    Command="{Binding AddCommand}" />
                                            <Button Content="Ignore" Style="{StaticResource BtnGhost}" Margin="6,0,0,0"
                                                    Padding="12,4" Command="{Binding IgnoreCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewDeviceAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Address of a controller you already know, for example 192.168.0.100" />
                        <Button Grid.Column="1" Content="Add by address" Style="{StaticResource BtnPrimary}"
                                Margin="8,0,0,0" Command="{Binding AddManualDeviceCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding ManualError}" Style="{StaticResource TxtCaption}"
                               Foreground="{StaticResource Err}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ManualError, Converter={StaticResource EmptyToCollapsed}}" />

                    <TextBlock Text="Discovery only lists what it found. Nothing is added until you press Add."
                               Style="{StaticResource TxtCaption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ================= device cards ================= -->
            <ItemsControl ItemsSource="{Binding DeviceList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- header -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0"
                                                 Fill="{Binding StatusKey, Converter={StaticResource StatusToBrush}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                       Foreground="{Binding StatusKey, Converter={StaticResource StatusToBrush}}" />
                                        </Border>
                                    </StackPanel>

                                    <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  ToolTip="Enable or disable this device. Disabling also releases its socket." />
                                </Grid>

                                <!-- meta -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="17,6,0,0">
                                    <TextBlock Text="{Binding AddressText}" Style="{StaticResource TxtCaption}" />
                                    <TextBlock Text="·" Style="{StaticResource TxtCaption}" Margin="8,0" />
                                    <TextBlock Text="{Binding MappingSummary}" Style="{StaticResource TxtCaption}" />
                                </StackPanel>

                                <Border Grid.Row="2" Height="1" Background="{StaticResource Hairline}"
                                        Margin="0,14,0,14" />

                                <!-- brightness -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Brightness" Style="{StaticResource TxtLabel}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding BrightnessMax}"
                                            Value="{Binding Brightness, Mode=TwoWay}" VerticalAlignment="Center"
                                            ToolTip="Overall brightness reported to the controller." />
                                    <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0:0}}"
                                               Style="{StaticResource TxtMono}" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- physical window -->
                                <Grid Grid.Row="4" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="LED window" Style="{StaticResource TxtLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding LedStart, Mode=TwoWay, ValidatesOnExceptions=True}"
                                             ToolTip="First LED of this device, 0 based." />
                                    <TextBlock Grid.Column="2" Text="to" Style="{StaticResource TxtCaption}"
                                               Margin="8,0,8,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Text="{Binding LedEnd, Mode=TwoWay, ValidatesOnExceptions=True}"
                                             ToolTip="One past the last LED. 51 means the whole 51 LED strip." />
                                    <Button Grid.Column="4" Content="All" Style="{StaticResource BtnGhost}"
                                            Margin="8,0,0,0" Padding="10,4" Command="{Binding UseAllLedsCommand}"
                                            ToolTip="Use every LED the controller reports." />
                                    <TextBlock Grid.Column="5" Style="{StaticResource TxtCaption}" Margin="12,0,0,0"
                                               VerticalAlignment="Center">
                                        <Run Text="of" />
                                        <Run Text="{Binding LedCount, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>

                                <!-- footer -->
                                <Grid Grid.Row="5" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding LastError}" Style="{StaticResource TxtCaption}"
                                               Foreground="{StaticResource Err}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding LastError, Converter={StaticResource EmptyToCollapsed}}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Open in WLED" Style="{StaticResource BtnGhost}"
                                                Margin="0,0,6,0" Command="{Binding OpenCommand}"
                                                Visibility="{Binding CanOpenInBrowser, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Edit mapping" Style="{StaticResource BtnGhost}"
                                                ToolTip="Jump to this device on the Mapping page."
                                                Margin="0,0,6,0" CommandParameter="Mapping"
                                                Command="{Binding DataContext.NavigateCommand,
                                                                  RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                        <Button Content="Remove" Style="{StaticResource BtnDanger}"
                                                ToolTip="Remove the device from this app. The controller itself is untouched."
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.RemoveDeviceCommand,
                                                                  RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================= empty state ================= -->
            <Border Style="{StaticResource Inset}" Margin="0,4,0,0"
                    Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="No devices yet" Style="{StaticResource TxtH2}" />
                    <TextBlock Text="Use Add WLED, or let the studio find controllers on the Settings page."
                               Style="{StaticResource TxtCaption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
