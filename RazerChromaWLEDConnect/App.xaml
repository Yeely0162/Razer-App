<Application x:Class="RazerChromaWLEDConnect.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RazerChromaWLEDConnect.Converters"
             StartupUri="MainWindow.xaml" Exit="AppExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:HexToBrushConverter x:Key="HexToBrush" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:StatusKeyToBrushConverter x:Key="StatusToBrush" />
            <converters:EmptyStringToVisibilityConverter x:Key="EmptyToCollapsed" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
