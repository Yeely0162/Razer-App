<UserControl x:Class="RazerChromaWLEDConnect.Controls.PaletteStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:RazerChromaWLEDConnect.Controls"
             mc:Ignorable="d" d:DesignHeight="60" d:DesignWidth="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PaletteBar Grid.Row="0" Height="30"
                             Channels="{Binding Channels, RelativeSource={RelativeSource AncestorType={x:Type controls:PaletteStrip}}}"
                             Revision="{Binding Revision, RelativeSource={RelativeSource AncestorType={x:Type controls:PaletteStrip}}}"
                             ActiveStart="{Binding ActiveStart, RelativeSource={RelativeSource AncestorType={x:Type controls:PaletteStrip}}}"
                             ActiveEnd="{Binding ActiveEnd, RelativeSource={RelativeSource AncestorType={x:Type controls:PaletteStrip}}}" />

        <ItemsControl Grid.Row="1" Margin="0,2,0,0"
                      ItemsSource="{Binding Channels, RelativeSource={RelativeSource AncestorType={x:Type controls:PaletteStrip}}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:ChannelTickPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border Width="1" Height="4" Background="#40FFFFFF" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="#8A9299"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
