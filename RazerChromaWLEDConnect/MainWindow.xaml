<Window x:Class="RazerChromaWLEDConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:views="clr-namespace:RazerChromaWLEDConnect.Views"
        mc:Ignorable="d"
        Title="Razer Chroma · WLED Studio"
        Width="1100" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Closing="WindowClosing"
        StateChanged="WindowStateChanged"
        Icon="/razer-wled.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== navigation rail ===================== -->
        <Border Grid.Column="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,24">
                        <Border Width="10" Height="10" CornerRadius="2"
                                Background="{StaticResource Accent}" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Razer Chroma" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="WLED Studio" Style="{StaticResource TxtCaption}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation"
                                 Content="Overview" IsChecked="{Binding IsOverview, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Overview" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Margin="0,2,0,0"
                                 Content="Devices" IsChecked="{Binding IsDevices, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Devices" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Margin="0,2,0,0"
                                 Content="Mapping" IsChecked="{Binding IsMapping, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Mapping" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Margin="0,2,0,0"
                                 Content="Performance" IsChecked="{Binding IsPerformance, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Performance" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Margin="0,2,0,0"
                                 Content="Settings" IsChecked="{Binding IsSettings, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Inset}" Padding="10,9">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding ChromaStatusKey, Converter={StaticResource StatusToBrush}}" />
                                <TextBlock Text="{Binding StatusHeadline}" Margin="8,0,0,0"
                                           FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding ChromaStatusText}" Style="{StaticResource TxtCaption}"
                                       Margin="15,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v0.1.0" Style="{StaticResource TxtCaption}" Margin="10,12,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== content ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,18,24,14"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource TxtTitle}" />
                        <TextBlock Text="{Binding ChannelSummary}" Style="{StaticResource TxtCaption}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sync" Style="{StaticResource TxtLabel}" Margin="0,0,10,0" />
                        <ToggleButton Style="{StaticResource Switch}"
                                      IsChecked="{Binding SyncEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <views:OverviewView Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisibility}}" />
                <views:DevicesView Visibility="{Binding IsDevices, Converter={StaticResource BoolToVisibility}}" />
                <views:MappingView Visibility="{Binding IsMapping, Converter={StaticResource BoolToVisibility}}" />
                <views:PerformanceView Visibility="{Binding IsPerformance, Converter={StaticResource BoolToVisibility}}" />
                <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <tb:TaskbarIcon x:Name="TrayIcon" IconSource="/razer-wled.ico"
                        ToolTipText="Razer Chroma WLED Studio"
                        TrayMouseDoubleClick="TrayShow">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="TrayMenuOpened">
                    <MenuItem Header="Open studio" Click="TrayShow" />
                    <MenuItem x:Name="TraySyncItem" Header="Pause sync" Click="TrayToggleSync" />
                    <Separator />
                    <MenuItem Header="Quit" Click="TrayQuit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
