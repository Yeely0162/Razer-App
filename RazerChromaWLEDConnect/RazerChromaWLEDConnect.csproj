<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RazerChromaWLEDConnect</RootNamespace>
    <AssemblyName>RazerChromaWLEDConnect</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <ApplicationIcon>razer-wled.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Razer Chroma WLED Connect</AssemblyTitle>
    <Product>Razer Chroma WLED Connect</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="razer-wled.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ChromaBroadcastSDK.NET" Version="1.0.4" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="HidApiAdapter" Version="1.0.6" GeneratePathProperty="true" />
    <PackageReference Include="System.Management" Version="6.0.0" />
    <PackageReference Include="Tmds.MDns" Version="0.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazerChromaWLEDConnect.Core\RazerChromaWLEDConnect.Core.csproj" />
  </ItemGroup>

  <!-- The original project pointed straight at a developer's NuGet cache. Copy the native
       HID library out of the package instead, so the build works on any machine. -->
  <Target Name="CopyHidApiNative" AfterTargets="Build">
    <ItemGroup>
      <HidApiFiles Include="$(PkgHidApiAdapter)\contentFiles\any\netstandard2.0\hidapi*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(HidApiFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
